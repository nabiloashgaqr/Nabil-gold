+        value = re.sub(r"(?i)\bpaper[\s-]*trading\b", "demo execution", value)
+        value = re.sub(r"(?i)\bpaper[\s-]*traded\b", "evaluated on demo", value)
+        value = re.sub(r"(?i)\bpaper_trading\b", "demo", value)
