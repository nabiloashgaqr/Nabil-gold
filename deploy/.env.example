# ══════════════════════════════════════════════════════════════════════════
# Nabil-gold — DEMO-ONLY VPS .env (branch demo/mt5)
# Copy to C:\Nabil-gold\.env and fill EVERY key.
# NEVER commit a filled .env, and NEVER put MT5_* on GitHub.
# ══════════════════════════════════════════════════════════════════════════

# ── Supabase ──
SUPABASE_URL=
SUPABASE_KEY=

# ── Telegram (the demo chat receives all 🧪 DEMO cards) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DEMO_CHAT_ID=

# ── LLM (Gemini is the working key; the other two optional) ──
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Market data: FALLBACK only when the MT5 feed fails ──
TWELVEDATA_API_KEY=

# ── Demo stream (fixed; wrappers set the same values too) ──
EXECUTION_MODE=mt5_demo
TRADES_TABLE=trades_demo
DATA_SOURCE_PRIMARY=mt5

# ── MetaTrader 5 (DEMO account only — never GitHub) ──
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# ── Optional: only if you enable SS_SubscriptionBot in vps_setup.ps1 ──
SUBSCRIPTION_BOT_TOKEN=
ADMIN_IDS=
ADMIN_CONTACT=@Smart_Pro2026
TIMEZONE=Asia/Hebron
