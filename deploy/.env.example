# ══════════════════════════════════════════════════════════════════════════
# Nabil-gold — FULL VPS .env (paper + demo + subscription bot, one file)
# Copy to C:\Nabil-gold\.env and fill EVERY key.
# NOTE: the task wrappers in deploy\tasks set EXECUTION_MODE / TRADES_TABLE /
# DATA_SOURCE_PRIMARY per stream; real env vars always win over this file.
# NEVER commit a filled .env, and NEVER put MT5_* on GitHub.
# ══════════════════════════════════════════════════════════════════════════

# ── Supabase (shared by everything) ──
SUPABASE_URL=
SUPABASE_KEY=

# ── Telegram — main bot + paper channel ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Telegram — demo channel (cards prefixed 🧪 DEMO) ──
TELEGRAM_DEMO_CHAT_ID=

# ── LLM keys (Gemini is the working fallback; the other two are optional) ──
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Market data: paper primary; demo fallback when MT5 feed fails ──
TWELVEDATA_API_KEY=

# ── Subscription bot (was GitHub secret of the same names) ──
SUBSCRIPTION_BOT_TOKEN=
ADMIN_IDS=
ADMIN_CONTACT=@Smart_Pro2026
TIMEZONE=Asia/Hebron

# ── Safe defaults = PAPER. Demo wrappers override these per task. ──
EXECUTION_MODE=paper
TRADES_TABLE=trades
DATA_SOURCE_PRIMARY=twelvedata

# ── MetaTrader 5 (DEMO account only — never GitHub) ──
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
